      "id": "usage-provider-omitted-cache-write-and-reasoning",
      "operation": "usage-presence",
      "input": {
        "fields": ["cacheCreateTotal", "thinking"],
        "values": {"cacheCreateTotal": 0, "thinking": 0},
        "presence": {"cacheCreateTotal": false, "thinking": false}
      },
      "expected": {
        "cacheCreateTotal": {"state": "unavailable"},
        "thinking": {"state": "unavailable"}
      }
    },
    {
      "id": "usage-provider-reported-explicit-zero",
      "operation": "usage-presence",
      "input": {
        "fields": ["cacheCreateTotal", "thinking"],
        "values": {"cacheCreateTotal": 0, "thinking": 0},
        "presence": {"cacheCreateTotal": true, "thinking": true}
      },
      "expected": {
        "cacheCreateTotal": {"state": "measured", "value": 0},
        "thinking": {"state": "measured", "value": 0}
      }
    },
    {
      "id": "route-keeps-requested-effective-and-served-distinct",
      "operation": "route-identity",
      "input": {
        "modelMap": {"model:model-requested": "model-effective"},
        "requestedModel": "model-requested",
        "servedModel": "model-served"
      },
      "expected": {
        "requestedModel": "model-requested",
        "effectiveModel": "model-effective",
        "servedModel": "model-served",
        "mapped": true
      }
    },
    {
